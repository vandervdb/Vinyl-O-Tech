<?xml version="1.0" encoding="utf-8"?>
<!-- Disque vinyle statique : sillons concentriques + label accent au centre.
     Pour la version animée (rotation), voir VinylDisc.kt / avd_splash_vinyl.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="@color/vot_vinyl_rim"/></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval"><solid android:color="@color/vot_vinyl_deep"/></shape></item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval"><solid android:color="@color/vot_vinyl_groove_hi"/></shape></item>
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval"><solid android:color="@color/vot_vinyl_base"/></shape></item>
    <item android:left="17dp" android:top="17dp" android:right="17dp" android:bottom="17dp">
        <shape android:shape="oval"><solid android:color="@color/vot_vinyl_groove"/></shape></item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval"><solid android:color="@color/vot_vinyl_mid"/></shape></item>
    <item android:left="26dp" android:top="26dp" android:right="26dp" android:bottom="26dp">
        <shape android:shape="oval"><solid android:color="@color/vot_accent"/></shape></item>
    <item android:left="38dp" android:top="38dp" android:right="38dp" android:bottom="38dp">
        <shape android:shape="oval"><solid android:color="@color/vot_vinyl_hole"/></shape></item>
</layer-list>
