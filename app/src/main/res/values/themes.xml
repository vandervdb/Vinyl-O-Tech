<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Spotifymonorepo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Theme.VinylOTech" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/vot_accent</item>
        <item name="colorOnPrimary">@color/vot_on_accent</item>
        <item name="colorPrimaryContainer">@color/vot_accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/vot_text_on_media</item>
        <item name="colorSecondary">@color/vot_accent_soft</item>
        <item name="android:colorBackground">@color/vot_bg</item>
        <item name="colorSurface">@color/vot_surface</item>
        <item name="colorSurfaceContainerHigh">@color/vot_surface_high</item>
        <item name="colorOnSurface">@color/vot_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/vot_text_secondary</item>
        <item name="colorOutline">@color/vot_outline_strong</item>
        <item name="colorOutlineVariant">@color/vot_outline</item>

        <!-- Bord à bord : la pochette héros passe sous la status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <item name="shapeAppearanceCornerSmall">@style/Vot.Shape.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Vot.Shape.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Vot.Shape.Large</item>
    </style>

    <style name="Vot.Shape.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/vot_radius_chip</item>
    </style>
    <style name="Vot.Shape.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/vot_radius_card</item>
    </style>
    <style name="Vot.Shape.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/vot_radius_sheet</item>
    </style>
    <!-- Thème de lancement (SplashScreen API, Android 12+). Non câblé : le manifest
         pointe encore Theme.Spotifymonorepo. Pour l'activer il faut y déclarer
         android:theme="@style/Theme.VinylOTech.Starting" ET appeler
         installSplashScreen() au début de MainActivity.onCreate(). -->
    <style name="Theme.VinylOTech.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vot_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_vinyl</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.VinylOTech</item>
    </style>
</resources>
