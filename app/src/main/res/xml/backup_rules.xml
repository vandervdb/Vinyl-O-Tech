<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower (API 30-). Same exclusion as data_extraction_rules.xml, for the same
   reason: the Keystore master key does not travel with the backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/security_store.preferences_pb" />
</full-backup-content>
