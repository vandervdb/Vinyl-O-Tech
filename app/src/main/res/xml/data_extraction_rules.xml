<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+). security_store holds the Tink keyset and the tokens it encrypts; the
   Keystore master key that decrypts the keyset is never backed up nor transferred, so a restored
   copy could not be read on the new install. See TinkKeysetHandleProvider.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/security_store.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/security_store.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
